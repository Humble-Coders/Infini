# Copy to .env and fill in from your Firebase project (Console → Project settings → Your apps).
# NEXT_PUBLIC_ vars are shipped to the browser in plaintext — the Firebase web config is
# public by design, so that's fine here. Never add that prefix to a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional, Analytics only (see initAnalytics in lib/firebase/client.ts).
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# "staging" (default) or "production". Controls robots.txt and the
# X-Robots-Tag header — see next.config.ts and app/robots.ts. Only ever set to
# "production" on the T26 production deploy.
NEXT_PUBLIC_SITE_ENV=staging

# Admin SDK (backend/firebase/admin.ts) — SERVER ONLY, never NEXT_PUBLIC_.
# Only required for local dev; on Firebase App Hosting these are unset and the
# Admin SDK falls back to Application Default Credentials automatically.
# Generate a key at Console → Project settings → Service accounts →
# Generate new private key. Never commit the downloaded JSON — copy the three
# fields into these vars instead.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Alternative to the three keys above, and the simpler option: point at the
# downloaded service-account JSON instead of pasting its private key in here.
# The file matches .gitignore's *firebase-adminsdk*.json rule, so it stays out
# of git. Used by the seed and content scripts via applicationDefault().
GOOGLE_APPLICATION_CREDENTIALS=

# Local dev only: run `firebase emulators:start --only firestore` and seed it
# (see README), then set this so the web SDK reads from the emulator instead of
# the real project. Leave empty everywhere else. Only honoured when NODE_ENV=development.
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=

# --- Admin panel (server only) ---------------------------------------------
# Owner (break-glass) account: the one Super Admin defined here. ADMIN_PASSWORD
# must be 12+ characters; there is no default, sign-in stays off without it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs owner session cookies. Required in production (32+ random characters,
# e.g. `openssl rand -base64 48`); admin sign-in is disabled without it.
ADMIN_SESSION_SECRET=
# Shared secret for the /api/revalidate webhook.
REVALIDATE_SECRET=

# --- Email (server only): enquiry notifications and team invites -----------
# e.g. smtp.gmail.com / 465 / a Google App Password. Without these, enquiries
# are still saved and invites show a link to hand over manually.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated inboxes that receive new-enquiry emails.
LEAD_NOTIFY_TO=

# --- Contact form spam protection (optional) --------------------------------
# reCAPTCHA v3 keys from https://www.google.com/recaptcha/admin (add the site's
# domains there). Leave both empty to keep it off; set both to switch it on.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Lowest score accepted (0.0 bot - 1.0 human). Default 0.5.
RECAPTCHA_MIN_SCORE=
