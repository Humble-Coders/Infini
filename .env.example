# Copy to .env and fill in from your Firebase project (Console → Project settings → Your apps).
# NEXT_PUBLIC_ vars are shipped to the browser in plaintext — the Firebase web config is
# public by design, so that's fine here. Never add that prefix to a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional, Analytics only (see initAnalytics in lib/firebase/client.ts).
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# "staging" (default) or "production". Controls robots.txt and the
# X-Robots-Tag header — see next.config.ts and app/robots.ts. Only ever set to
# "production" on the T26 production deploy.
NEXT_PUBLIC_SITE_ENV=staging

# Admin SDK (backend/firebase/admin.ts) — SERVER ONLY, never NEXT_PUBLIC_.
# Only required for local dev; on Firebase App Hosting these are unset and the
# Admin SDK falls back to Application Default Credentials automatically.
# Generate a key at Console → Project settings → Service accounts →
# Generate new private key. Never commit the downloaded JSON — copy the three
# fields into these vars instead.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Alternative to the three keys above, and the simpler option: point at the
# downloaded service-account JSON instead of pasting its private key in here.
# The file matches .gitignore's *firebase-adminsdk*.json rule, so it stays out
# of git. Used by the seed and content scripts via applicationDefault().
GOOGLE_APPLICATION_CREDENTIALS=

# Local dev only: run `firebase emulators:start --only firestore` and seed it
# (see README), then set this so the web SDK reads from the emulator instead of
# the real project. Leave empty everywhere else. Only honoured when NODE_ENV=development.
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=

# --- Admin dashboard link (separate deployment: i-shubham24/Infini-Dashboard) ---
# Where /admin on this site redirects, and the link in lead notification emails.
ADMIN_DASHBOARD_URL=

# Shared secret (32+ random characters) the dashboard sends to /api/revalidate
# after every save so changes go live immediately. Must equal the dashboard's
# REVALIDATE_SECRET. Unset = endpoint disabled (pages still refresh every 10 min).
REVALIDATE_SECRET=

# --- New-enquiry email to the INFINI team (SERVER ONLY, never NEXT_PUBLIC_) ---
# Sent after each contact-form lead is saved to Firestore. With these unset,
# leads are still saved and shown in the dashboard; just no email goes out.
# For Gmail/Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 and an
# App Password (Google account → Security → App passwords) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER.
SMTP_FROM=
# Comma-separated recipients, e.g. superfinish@infini.co.in
LEAD_NOTIFY_TO=

# --- Analytics (optional, public by design) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. When set, visitors see
# a cookie banner and GA loads only after they click "Allow analytics".
# Unset = no banner and no analytics at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
