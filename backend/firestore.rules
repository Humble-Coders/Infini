rules_version = '2';

// See docs/PRD.md §4.3 (data model) and §4.4 (security model), and
// docs/DATA-MODEL.md for the field-level admin-editable breakdown.
//
// Roles come from the Firebase Auth custom claim `role`, set server-side
// (T6) — never trust a role read from client state. The Admin SDK (used by
// Cloud Functions) bypasses these rules entirely, which is how the RFQ
// function writes `leads` despite the deny-all below.
service cloud.firestore {
  match /databases/{database}/documents {
    function role() {
      return request.auth.token.role;
    }

    function isSuperAdmin() {
      return request.auth != null && role() == "superAdmin";
    }

    function isContentEditor() {
      return request.auth != null && role() == "contentEditor";
    }

    // Super Admin and Content Editor both have Content CRUD + Media per the
    // PRD §3B role matrix.
    function canWriteContent() {
      return isSuperAdmin() || isContentEditor();
    }

    // Public content collections: public read of published documents only,
    // writes restricted to Super Admin / Content Editor.
    match /industries/{docId} {
      allow read: if resource.data.published == true;
      allow write: if canWriteContent();
    }

    match /caseStudies/{docId} {
      allow read: if resource.data.published == true;
      allow write: if canWriteContent();
    }

    match /certifications/{docId} {
      allow read: if resource.data.published == true;
      allow write: if canWriteContent();
    }

    match /testimonials/{docId} {
      allow read: if resource.data.published == true;
      allow write: if canWriteContent();
    }

    match /events/{docId} {
      allow read: if resource.data.published == true;
      allow write: if canWriteContent();
    }

    // news uses status ("draft" | "published") rather than a published bool.
    match /news/{docId} {
      allow read: if resource.data.status == "published";
      allow write: if canWriteContent();
    }

    // Singleton page content and global settings have no draft state — the
    // live document is always the public one. Read is public; write is
    // gated same as other content, except settings (Users & Settings column
    // in the PRD role matrix) which is Super Admin only.
    match /pages/{docId} {
      allow read: if true;
      allow write: if canWriteContent();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Media library index — not read directly by public pages (asset URLs
    // are copied into content fields), so no public read rule. Admin
    // reads/writes match the Media column of the role matrix.
    match /media/{docId} {
      allow read, write: if canWriteContent();
    }

    // Admin accounts — Users & Settings column: Super Admin only, plus a
    // user may always read their own document.
    match /users/{uid} {
      allow read: if isSuperAdmin() || request.auth.uid == uid;
      allow write: if isSuperAdmin();
    }

    // leads is write-only from the server. No client — authenticated or
    // not, any role — ever reads or writes it directly; the RFQ Cloud
    // Function (T17) is the sole writer via the Admin SDK, which bypasses
    // these rules. This explicit deny (rather than just omitting the match)
    // documents the boundary and blocks accidental future permissive rules.
    match /leads/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Everything else stays deny-all by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
